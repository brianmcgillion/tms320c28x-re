# uv.lock IS tracked: it is what makes CI and the devShell resolve the same
# Python environment. It was ignored here while sitting in the working tree,
# so no clone could reproduce the environment it describes.

# TI reference manuals — fetched by docs/reference/fetch.sh, never committed
docs/reference/*.pdf
docs/reference/*.txt
docs/RENAMES.md
docs/plans/
core/target/
